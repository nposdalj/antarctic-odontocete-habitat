daily_env_raw <- data %>%
mutate(date = as.Date(date)) %>%
filter(date >= start_date_env) %>%
group_by(date) %>%
summarise(
chla_anom  = mean(chla_anom,  na.rm = TRUE),
o2_anom = mean(o2_anom,  na.rm = TRUE),
productivity_anom = mean(productivity_anom, na.rm = TRUE),
temp_anom = mean(temp_anom,  na.rm = TRUE),
zos_mean = mean(zos_mean, na.rm = TRUE),
salinity_anom = mean(salinity_anom, na.rm = TRUE),
mixed_layer_anom = mean(mixed_layer_anom, na.rm = TRUE),
siconc_mean = mean(siconc_mean, na.rm = TRUE),
sithick_mean = mean(sithick_mean, na.rm = TRUE),
EKE_mean = mean(EKE_mean, na.rm = TRUE),
EKE_mad = mean(EKE_mad, na.rm = TRUE),
.groups = "drop"
)
date_range <- seq(min(daily_env_raw$date), max(daily_env_raw$date), by = "day")
daily_krill <- C1_CATCH %>%
filter(taxon_code == taxon_code) %>%
left_join(haul_sites, by = "c1_id") %>%
filter(!is.na(Site)) %>%
left_join(C1 %>% select(c1_id, date_catchperiod_start), by = "c1_id") %>%
mutate(date = as.Date(date_catchperiod_start)) %>%
filter(date >= start_date_catch) %>%
group_by(date) %>%
summarise(value = sum(greenweight_caught_kg, na.rm = TRUE), .groups = "drop")
daily_combined <- merge(daily_env_raw, daily_krill, by = "date", all.x = TRUE)
model_data = daily_combined
# Square root transformation
model_data <- model_data %>%
mutate(
value_sqrt = sqrt(value),       # square root transform
value_log  = log1p(value)       # log transform: log(1 + x) to handle zeros
)
# Visualize the original vs transformed distributions
par(mfrow = c(1,3))  # 1 row, 3 columns
hist(model_data$value, main = "Original Krill Data", xlab = "kg", col = "lightblue", breaks = 30)
hist(model_data$value_sqrt, main = "Square Root Transform", xlab = "sqrt(kg)", col = "lightgreen", breaks = 30)
hist(model_data$value_log, main = "Log Transform", xlab = "log(kg+1)", col = "lightpink", breaks = 30)
par(mfrow = c(1,1))
gam_model <- gam(
value_sqrt ~ s(EKE_mad, k = 4) + s(temp_anom, k = 4) + s(salinity_anom, k = 4),
data = model_data,
family = gaussian()
)
acf_res <- acf(residuals(gam_model), lag.max = 100, plot = TRUE)
CI = ggfortify:::confint.acf(acf_res)
ACFidx = which(acf_res[["acf"]] < CI, arr.ind = TRUE)
ACFval = ACFidx[1]
ACFval <- max(1, ACFval)  # prevent 0 or NA
my_unit <- paste(ACFval, "days")
print(paste("Estimated autocorrelation length (days):", ACFval))
model_data_binned_withNAs <- model_data %>%
group_by(bin = floor_date(date, unit = my_unit)) %>%
summarise(across(where(is.numeric), \(x) mean(x, na.rm = TRUE)))
model_data_binned <- model_data_binned_withNAs %>%
filter(!is.na(value))
# -----------------------------
# CHECK AUTOCORRELATION
# -----------------------------
residuals_gam <- residuals(gam_model)
acf_res <- acf(residuals_gam, lag.max = 100, plot = TRUE)
model_data_binned$siconc_mean[is.na(model_data_binned$siconc_mean)] <- 0
pred <- c("zos_mean", "mixed_layer_anom", "salinity_anom",
"temp_anom", 'chla_anom', 'EKE_mad', 'siconc_mean', 'o2_anom')
mod_formula <- paste('value_sqrt', "~", paste(pred, collapse = " + "))
vif_krill <- glm(as.formula(mod_formula),family=gaussian, data = model_data_binned)
vif(vif_krill)
pred <- c("mixed_layer_anom", "salinity_anom",
"temp_anom", 'chla_anom', 'EKE_mad', 'siconc_mean', 'o2_anom')
mod_formula <- paste('value_sqrt', "~", paste(pred, collapse = " + "))
vif_krill <- glm(as.formula(mod_formula),family=gaussian, data = model_data_binned)
vif(vif_krill)
gam_model <- gam(
value_sqrt ~
s(mixed_layer_anom, k = 4) +
s(salinity_anom, k = 4) +
s(chla_anom, k = 4) +
s(EKE_mad, k = 4) +
s(siconc_mean, k = 4) +
s(o2_anom, k = 4),
data = model_data_binned,
family = gaussian()
)
summary(gam_model)
gam_model <- gam(
value_sqrt ~
s(salinity_anom, k = 4) +
s(chla_anom, k = 4) +
s(EKE_mad, k = 4) +
s(siconc_mean, k = 4) +
s(o2_anom, k = 4),
data = model_data_binned,
family = gaussian()
)
summary(gam_model)
gam_model <- gam(
value_sqrt ~
s(chla_anom, k = 4) +
s(EKE_mad, k = 4) +
s(siconc_mean, k = 4) +
s(o2_anom, k = 4),
data = model_data_binned,
family = gaussian()
)
summary(gam_model)
gam_model <- gam(
value_sqrt ~
s(chla_anom, k = 4) +
s(EKE_mad, k = 4) +
s(siconc_mean, k = 4),
data = model_data_binned,
family = gaussian()
)
summary(gam_model)
gam_model <- gam(
value_sqrt ~
s(EKE_mad, k = 4) +
s(siconc_mean, k = 4),
data = model_data_binned,
family = gaussian()
)
summary(gam_model)
model_data_binned$env_combined <- rowMeans(
model_data_binned[, c("siconc_mean","EKE_mad")],
na.rm = TRUE
)
draw(gam_model, scales = "fixed")
summary(gam_model)
par(mfrow = c(2, 3))
plot(gam_model, pages = 1, residuals = TRUE, pch = 1, shade = TRUE, all.terms = TRUE)
EKE_mad = seq(
min(model_data_binned$EKE_mad, na.rm = TRUE),
max(model_data_binned$EKE_mad, na.rm = TRUE),
length.out = 200
)
siconc_mean = mean(model_data_binned$siconc_mean, na.rm = TRUE)
eke_pred <- predict(gam_model, newdata = eke_grid, se.fit = TRUE)
eke_grid$fit   <- eke_pred$fit
eke_grid$upper <- eke_grid$fit + 1.96 * eke_pred$se.fit
eke_grid$lower <- eke_grid$fit - 1.96 * eke_pred$se.fit
ggplot(eke_grid, aes(x = EKE_mad, y = fit)) +
geom_ribbon(aes(ymin = lower, ymax = upper),
fill = "black", alpha = 0.25) +
geom_line(color = "black", linewidth = 1.2) +
theme_classic(base_size = 14) +
labs(
x = "EKE (MAD)",
y = "Effect on Krill (sqrt)",
title = "GAM smooth: EKE"
)
siconc_grid <- data.frame(
siconc_mean = seq(
min(model_data_binned$siconc_mean, na.rm = TRUE),
max(model_data_binned$siconc_mean, na.rm = TRUE),
length.out = 200
),
EKE_mad = mean(model_data_binned$EKE_mad, na.rm = TRUE)
)
siconc_pred <- predict(gam_model, newdata = siconc_grid, se.fit = TRUE)
siconc_grid$fit   <- siconc_pred$fit
siconc_grid$upper <- siconc_grid$fit + 1.96 * siconc_pred$se.fit
siconc_grid$lower <- siconc_grid$fit - 1.96 * siconc_pred$se.fit
ggplot(siconc_grid, aes(x = siconc_mean, y = fit)) +
geom_ribbon(aes(ymin = lower, ymax = upper),
fill = "black", alpha = 0.25) +
geom_line(color = "black", linewidth = 1.2) +
theme_classic(base_size = 14) +
labs(
x = "Sea Ice Concentration",
y = "Effect on Krill (sqrt)",
title = "GAM smooth: Sea Ice"
)
eke_grid <- data.frame(
EKE_mad = seq(
min(model_data_binned$EKE_mad, na.rm = TRUE),
max(model_data_binned$EKE_mad, na.rm = TRUE),
length.out = 200
),
siconc_mean = mean(model_data_binned$siconc_mean, na.rm = TRUE)
)
# prediction (must succeed BEFORE anything else)
eke_pred <- predict(gam_model, newdata = eke_grid, se.fit = TRUE)
# attach results
eke_grid$fit   <- eke_pred$fit
eke_grid$se    <- eke_pred$se.fit
eke_grid$upper <- eke_grid$fit + 1.96 * eke_grid$se
eke_grid$lower <- eke_grid$fit - 1.96 * eke_grid$se
# plot
ggplot(eke_grid, aes(x = EKE_mad, y = fit)) +
geom_ribbon(aes(ymin = lower, ymax = upper),
fill = "steelblue", alpha = 0.25) +
geom_line(color = "steelblue4", linewidth = 1.2) +
theme_classic(base_size = 14) +
labs(
x = "EKE (MAD)",
y = "Krill response (sqrt)",
title = "GAM smooth: EKE"
)
siconc_grid <- data.frame(
siconc_mean = seq(
min(model_data_binned$siconc_mean, na.rm = TRUE),
max(model_data_binned$siconc_mean, na.rm = TRUE),
length.out = 200
),
EKE_mad = mean(model_data_binned$EKE_mad, na.rm = TRUE)
)
siconc_pred <- predict(gam_model, newdata = siconc_grid, se.fit = TRUE)
siconc_grid$fit   <- siconc_pred$fit
siconc_grid$upper <- siconc_grid$fit + 1.96 * siconc_pred$se.fit
siconc_grid$lower <- siconc_grid$fit - 1.96 * siconc_pred$se.fit
ggplot(siconc_grid, aes(x = siconc_mean, y = fit)) +
geom_ribbon(aes(ymin = lower, ymax = upper),
fill = "black", alpha = 0.25) +
geom_line(color = "black", linewidth = 1.2) +
theme_classic(base_size = 14) +
labs(
x = "Sea Ice Concentration",
y = "Effect on Krill (sqrt)",
title = "GAM smooth: Sea Ice"
)
model_data_binned$env_combined <- rowMeans(
model_data_binned[, c("siconc_mean","EKE_mad")],
na.rm = TRUE
)
draw(gam_model, scales = "fixed")
summary(gam_model)
par(mfrow = c(2, 3))
plot(gam_model, pages = 1, residuals = TRUE, pch = 1, shade = TRUE, all.terms = TRUE)
eke_grid <- data.frame(
x = seq(
min(model_data_binned$EKE_mad, na.rm = TRUE),
max(model_data_binned$EKE_mad, na.rm = TRUE),
length.out = 200
),
siconc_mean = mean(model_data_binned$siconc_mean, na.rm = TRUE)
)
eke_pred <- predict(gam_model, newdata = eke_grid, se.fit = TRUE)
eke_grid <- eke_grid %>%
mutate(
fit   = eke_pred$fit,
se    = eke_pred$se.fit,
upper = fit + 1.96 * se,
lower = fit - 1.96 * se,
variable = "EKE_mad"
)
# -----------------------------
# 2. SICONC prediction grid
# -----------------------------
siconc_grid <- data.frame(
x = seq(
min(model_data_binned$siconc_mean, na.rm = TRUE),
max(model_data_binned$siconc_mean, na.rm = TRUE),
length.out = 200
),
EKE_mad = mean(model_data_binned$EKE_mad, na.rm = TRUE)
)
siconc_pred <- predict(gam_model, newdata = siconc_grid, se.fit = TRUE)
siconc_grid <- siconc_grid %>%
mutate(
fit   = siconc_pred$fit,
se    = siconc_pred$se.fit,
upper = fit + 1.96 * se,
lower = fit - 1.96 * se,
variable = "siconc_mean"
)
# -----------------------------
# 3. Combine both
# -----------------------------
plot_data <- bind_rows(eke_grid, siconc_grid)
# -----------------------------
# 4. Plot side-by-side
# -----------------------------
ggplot(plot_data, aes(x = x, y = fit)) +
geom_ribbon(aes(ymin = lower, ymax = upper),
fill = "grey70", alpha = 0.4) +
geom_line(color = "black", linewidth = 1.1) +
facet_wrap(~ variable, scales = "free_x", nrow = 1) +
labs(
x = "Standardised environmental gradient",
y = "Effect on krill (sqrt scale)"
) +
theme_classic(base_size = 14) +
theme(
strip.text = element_text(size = 13),
axis.title = element_text(size = 13)
)
my_unit <- paste(ACFval, "days")
model_data_binned <- model_data %>%
mutate(date = as.Date(date)) %>%
group_by(bin = floor_date(date, unit = my_unit)) %>%
summarise(across(where(is.numeric), ~ mean(.x, na.rm = TRUE)),
.groups = "drop")
env_vars <- c(
"siconc_mean",
"EKE_mad"
)
model_data_binned <- model_data_binned %>%
mutate(
env_index = rowMeans(
scale(across(all_of(env_vars))),
na.rm = TRUE
)
)
gam_model <- gam(
value_sqrt ~ s(env_index, k = 4),
data = model_data_binned,
family = gaussian(),
method = "REML"
)
new_data <- data.frame(
env_index = seq(
min(model_data_binned$env_index, na.rm = TRUE),
max(model_data_binned$env_index, na.rm = TRUE),
length.out = 200
)
)
pred <- predict(gam_model, newdata = new_data, se.fit = TRUE)
new_data <- new_data %>%
mutate(
fit = pred$fit,
se = pred$se.fit,
upper = fit + 1.96 * se,
lower = fit - 1.96 * se
)
gam_sum <- summary(gam_model)
dev_expl <- round(gam_sum$dev.expl * 100, 1)
p_label <- paste0(
"p = ",
formatC(gam_sum$s.table[1, "p-value"], format = "f", digits = 7)
)
ggplot(new_data, aes(x = env_index)) +
geom_ribbon(aes(ymin = lower, ymax = upper),
fill = "black", alpha = 0.25) +
geom_line(aes(y = fit),
color = "black", linewidth = 1.2) +
geom_rug(data = model_data_binned,
aes(x = env_index),
inherit.aes = FALSE,
sides = "b",
alpha = 0.3) +
annotate("label",
x = Inf, y = Inf,
label = p_label,
hjust = 1.1, vjust = 1.2,
size = 4,
fill = "white") +
labs(
title = paste0(
"Krill Catch at King George Island\n",
"Deviance explained = ", dev_expl, "%"
),
x = "Environmental Index",
y = "Krill Catch"
) +
theme_classic(base_size = 14) +
theme(
panel.grid.major = element_line(color = "grey85", linewidth = 0.5),
panel.grid.minor = element_line(color = "grey92", linewidth = 0.3),
panel.border = element_rect(color = "black", fill = NA, linewidth = 1),
axis.line = element_line(color = "black"),
axis.text = element_text(color = "black"),
axis.title = element_text(color = "black"),
plot.margin = margin(t = 10, r = 10, b = 30, l = 10)
)
eke_grid <- data.frame(
x = seq(
min(model_data_binned$EKE_mad, na.rm = TRUE),
max(model_data_binned$EKE_mad, na.rm = TRUE),
length.out = 200
),
siconc_mean = mean(model_data_binned$siconc_mean, na.rm = TRUE)
)
eke_pred <- predict(gam_model, newdata = eke_grid, se.fit = TRUE)
eke_grid <- eke_grid %>%
mutate(
fit   = eke_pred$fit,
se    = eke_pred$se.fit,
upper = fit + 1.96 * se,
lower = fit - 1.96 * se,
variable = "EKE_mad"
)
# -----------------------------
# 2. SICONC prediction grid
# -----------------------------
siconc_grid <- data.frame(
x = seq(
min(model_data_binned$siconc_mean, na.rm = TRUE),
max(model_data_binned$siconc_mean, na.rm = TRUE),
length.out = 200
),
EKE_mad = mean(model_data_binned$EKE_mad, na.rm = TRUE)
)
siconc_pred <- predict(gam_model, newdata = siconc_grid, se.fit = TRUE)
siconc_grid <- siconc_grid %>%
mutate(
fit   = siconc_pred$fit,
se    = siconc_pred$se.fit,
upper = fit + 1.96 * se,
lower = fit - 1.96 * se,
variable = "siconc_mean"
)
# -----------------------------
# 3. Combine both
# -----------------------------
plot_data <- bind_rows(eke_grid, siconc_grid)
# -----------------------------
# 4. Plot side-by-side
# -----------------------------
ggplot(plot_data, aes(x = x, y = fit)) +
geom_ribbon(aes(ymin = lower, ymax = upper),
fill = "grey70", alpha = 0.4) +
geom_line(color = "black", linewidth = 1.1) +
facet_wrap(~ variable, scales = "free_x", nrow = 1) +
labs(
x = "Standardised environmental gradient",
y = "Effect on krill (sqrt scale)"
) +
theme_classic(base_size = 14) +
theme(
strip.text = element_text(size = 13),
axis.title = element_text(size = 13)
)
