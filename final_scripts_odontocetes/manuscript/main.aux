\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Temperature--salinity diagrams for EI, KGI, and CI over each site's recording period. Each point is a daily box-mean (±20\,km) value at one model level (0.5--1000\,m) from the Copernicus Marine Service global physics reanalysis, colored by depth (square-root scale). Grey contours show potential density anomaly (σθ, kg\,m$^{-3}$; labelled every 0.2\,kg m$^{-3}$), and the dashed line shows the surface freezing temperature.}}{17}{figure.caption.10}\protected@file@percent }
\newlabel{fig:ts}{{S1}{17}{Temperature--salinity diagrams for EI, KGI, and CI over each site's recording period. Each point is a daily box-mean (±20\unit {km}) value at one model level (0.5--1000\unit {m}) from the Copernicus Marine Service global physics reanalysis, colored by depth (square-root scale). Grey contours show potential density anomaly (σθ, kg\unit {m$^{-3}$}; labelled every 0.2\unit {kg m$^{-3}$}), and the dashed line shows the surface freezing temperature}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Evidence for the depth-layer boundaries at EI, KGI and CI. Left: 10-year mean profiles of potential temperature, salinity, potential density anomaly (σθ) and dissolved oxygen, with water-mass markers (dashed): deepest winter mixed layer (90th percentile of daily mixed layer depth), Winter Water temperature minimum (December--March mean profile), main pycnocline (maximum density gradient below the winter mixed layer), and the warm-water temperature maximum. Solid lines: boundaries of the three most coherent depth groups. Right: correlation between depths of daily temperature--salinity anomalies (seasonal cycle removed) over the 10-year record, with the coherence boundaries (CONISS clustering) and species depths (ticks). The adopted layers are 0--100, 100--500 and 500--1000\,m.}}{18}{figure.caption.11}\protected@file@percent }
\newlabel{fig:layers}{{S2}{18}{Evidence for the depth-layer boundaries at EI, KGI and CI. Left: 10-year mean profiles of potential temperature, salinity, potential density anomaly (σθ) and dissolved oxygen, with water-mass markers (dashed): deepest winter mixed layer (90th percentile of daily mixed layer depth), Winter Water temperature minimum (December--March mean profile), main pycnocline (maximum density gradient below the winter mixed layer), and the warm-water temperature maximum. Solid lines: boundaries of the three most coherent depth groups. Right: correlation between depths of daily temperature--salinity anomalies (seasonal cycle removed) over the 10-year record, with the coherence boundaries (CONISS clustering) and species depths (ticks). The adopted layers are 0--100, 100--500 and 500--1000\unit {m}}{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Sea-ice cutoffs for the habitat models and the number of time bins removed at each site. The cutoff is the highest bin-mean sea-ice concentration at which the species was detected at any site. Bin length was 4 days for all species except killer whales (2 days).}}{19}{table.caption.13}\protected@file@percent }
\newlabel{tab:icecut}{{S1}{19}{Sea-ice cutoffs for the habitat models and the number of time bins removed at each site. The cutoff is the highest bin-mean sea-ice concentration at which the species was detected at any site. Bin length was 4 days for all species except killer whales (2 days)}{table.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Duty-cycle subsampling of continuous CI recordings (mean \% retained, range across 100 phase offsets). BW58 was not detected at CI and could not be evaluated.}}{19}{table.caption.14}\protected@file@percent }
\newlabel{tab:duty}{{S2}{19}{Duty-cycle subsampling of continuous CI recordings (mean \% retained, range across 100 phase offsets). BW58 was not detected at CI and could not be evaluated}{table.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Effect of duty cycling on odontocete detections, estimated by subsampling the continuous recordings at Clarence Island (CI) to the duty cycles used at Elephant Island (EI; 5\,min on every 6\,min) and King George Island (KGI; 10\,min on every 13.33\,min) at 100 random phase offsets. Panels show the percentage of detection events, positive 5-min bins, and presence days retained relative to continuous recording. Points show the mean and bars the range across phase offsets. Dashed horizontal lines mark the proportion of time recorded under each duty cycle (83.3\% for EI, 75.0\% for KGI). Open symbols mark species not detected at the site whose duty cycle was simulated (sperm whale at KGI). BW58 is not shown because it was not detected at CI. Pm, sperm whale; Gm, long-finned pilot whale; Oo, killer whale; BW29, southern bottlenose whale; BW37, BW37 beaked whale.}}{19}{figure.caption.15}\protected@file@percent }
\newlabel{fig:duty}{{S3}{19}{Effect of duty cycling on odontocete detections, estimated by subsampling the continuous recordings at Clarence Island (CI) to the duty cycles used at Elephant Island (EI; 5\unit {min} on every 6\unit {min}) and King George Island (KGI; 10\unit {min} on every 13.33\unit {min}) at 100 random phase offsets. Panels show the percentage of detection events, positive 5-min bins, and presence days retained relative to continuous recording. Points show the mean and bars the range across phase offsets. Dashed horizontal lines mark the proportion of time recorded under each duty cycle (83.3\% for EI, 75.0\% for KGI). Open symbols mark species not detected at the site whose duty cycle was simulated (sperm whale at KGI). BW58 is not shown because it was not detected at CI. Pm, sperm whale; Gm, long-finned pilot whale; Oo, killer whale; BW29, southern bottlenose whale; BW37, BW37 beaked whale}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Comparison of the Copernicus reanalysis with HYCOM and MODIS over each site's recording period (±20\,km box). (a) Daily surface temperature from Copernicus (blue), HYCOM (orange) and Aqua MODIS (points; days with ≥ 20\% valid pixels) at EI, KGI and CI. (b) Bias (HYCOM $-$ Copernicus) and root-mean-square error of daily temperature and salinity at every Copernicus model level to 1000\,m, by site; dashed lines mark the layer boundaries (100 and 500\,m).}}{20}{figure.caption.17}\protected@file@percent }
\newlabel{fig:hycom}{{S4}{20}{Comparison of the Copernicus reanalysis with HYCOM and MODIS over each site's recording period (±20\unit {km} box). (a) Daily surface temperature from Copernicus (blue), HYCOM (orange) and Aqua MODIS (points; days with ≥ 20\% valid pixels) at EI, KGI and CI. (b) Bias (HYCOM $-$ Copernicus) and root-mean-square error of daily temperature and salinity at every Copernicus model level to 1000\unit {m}, by site; dashed lines mark the layer boundaries (100 and 500\unit {m})}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Validation of the Copernicus and HYCOM models against in-situ profiles from the World Ocean Database, 2014--2016. (a) Locations of the 915 profiles by instrument type, with the ±20\,km boxes around the recording sites; bathymetry from GMRT. (b) Bias (model $-$ observed, top) and root-mean-square error (bottom) of temperature, salinity and dissolved oxygen (Copernicus only) at each model level, computed on the same profiles and levels for both models (levels with ≥ 10 matched profiles). Dashed lines mark the layer boundaries (100 and 500\,m).}}{21}{figure.caption.18}\protected@file@percent }
\newlabel{fig:insitu}{{S5}{21}{Validation of the Copernicus and HYCOM models against in-situ profiles from the World Ocean Database, 2014--2016. (a) Locations of the 915 profiles by instrument type, with the ±20\unit {km} boxes around the recording sites; bathymetry from GMRT. (b) Bias (model $-$ observed, top) and root-mean-square error (bottom) of temperature, salinity and dissolved oxygen (Copernicus only) at each model level, computed on the same profiles and levels for both models (levels with ≥ 10 matched profiles). Dashed lines mark the layer boundaries (100 and 500\unit {m})}{figure.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces Sea-ice models (presence $\sim $ s(sea-ice concentration)) for each species and site, using all bins. ``Robust to AR(1)'': whether the effect remained significant when residual autocorrelation was modeled with an AR(1) process (significant effects only). ‡ Low-sample model (10--20 bins with detections).}}{21}{table.caption.20}\protected@file@percent }
\newlabel{tab:seaice}{{S3}{21}{Sea-ice models (presence $\sim $ s(sea-ice concentration)) for each species and site, using all bins. ``Robust to AR(1)'': whether the effect remained significant when residual autocorrelation was modeled with an AR(1) process (significant effects only). ‡ Low-sample model (10--20 bins with detections)}{table.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Centered partial effects (log scale) of sea-ice concentration from the sea-ice GAMs, shown for models in which the effect was significant ($p$ ≤ 0.05), with 95\% confidence bands (clipped at the panel limits) and the observed values of each bin (rug). Solid lines: effects that remained significant when residual autocorrelation was modeled with an AR(1) process; dashed lines: effects that did not. Curves of southern bottlenose whales and BW37 end at the highest sea-ice concentration at which the species was detected at that site (2.9--5.1\%), because no detections occurred at higher concentrations (34--36 bins) and the fitted decline beyond that point is not estimable; these curves are re-centered over the range shown.}}{22}{figure.caption.21}\protected@file@percent }
\newlabel{fig:icecurves}{{S6}{22}{Centered partial effects (log scale) of sea-ice concentration from the sea-ice GAMs, shown for models in which the effect was significant ($p$ ≤ 0.05), with 95\% confidence bands (clipped at the panel limits) and the observed values of each bin (rug). Solid lines: effects that remained significant when residual autocorrelation was modeled with an AR(1) process; dashed lines: effects that did not. Curves of southern bottlenose whales and BW37 end at the highest sea-ice concentration at which the species was detected at that site (2.9--5.1\%), because no detections occurred at higher concentrations (34--36 bins) and the fitted decline beyond that point is not estimable; these curves are re-centered over the range shown}{figure.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Diagnostics of the final habitat models. Tweedie $p$: estimated power parameter. Min k-index $p$: smallest $p$-value of the basis-dimension check across terms. Max concurvity: largest ``worst-case'' concurvity among terms. Lag-1 ACF and Ljung--Box $p$ (lags 1--5 bins): residual autocorrelation; $p$ ≤ 0.05 indicates remaining autocorrelation. ΔAIC with AR(1): change in AIC when an AR(1) process was added in glmmTMB (values $<$ $-$2 indicate support for AR(1); -- = AR(1) model did not converge).}}{23}{table.caption.23}\protected@file@percent }
\newlabel{tab:diag}{{S4}{23}{Diagnostics of the final habitat models. Tweedie $p$: estimated power parameter. Min k-index $p$: smallest $p$-value of the basis-dimension check across terms. Max concurvity: largest ``worst-case'' concurvity among terms. Lag-1 ACF and Ljung--Box $p$ (lags 1--5 bins): residual autocorrelation; $p$ ≤ 0.05 indicates remaining autocorrelation. ΔAIC with AR(1): change in AIC when an AR(1) process was added in glmmTMB (values $<$ $-$2 indicate support for AR(1); -- = AR(1) model did not converge)}{table.caption.23}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces Conditions on detection days for species--site combinations with too few detections to model ($<$10 bins with detections). EKE percentile: position of the median EKE on detection days among all recording days at that site. Sperm whales were never detected at KGI.}}{23}{table.caption.25}\protected@file@percent }
\newlabel{tab:rare}{{S5}{23}{Conditions on detection days for species--site combinations with too few detections to model ($<$10 bins with detections). EKE percentile: position of the median EKE on detection days among all recording days at that site. Sperm whales were never detected at KGI}{table.caption.25}{}}
